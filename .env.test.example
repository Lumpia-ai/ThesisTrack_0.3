# Separate Supabase TEST project for migrations and integration tests.
# Copy to .env.test and fill in values from the TEST project only — never the hosted project in .env.
# Every variable is prefixed TEST_ so it can't be mistaken for (or fall back to) the main .env values.
# scripts/test-db.mjs refuses to run if any of these point at the same Supabase project as .env.

# Settings → Database → Connection string → Transaction pooler (port 6543)
TEST_DATABASE_URL=postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Settings → Database → Connection string → Direct connection or Session pooler (port 5432); used for migrations
TEST_DIRECT_URL=postgresql://postgres.<test-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set to true only if your network validates Supabase's certificate chain
TEST_DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Settings → API
TEST_SUPABASE_URL=https://<test-project-ref>.supabase.co
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (not the main JWT_SECRET)
TEST_JWT_SECRET=
